let
    Raw = #table({"CREATE DATE", "USER ID", "OFFICE", "AMOUNT", "WHEN", "NOTES"}, {
        {"2024-01-05", "1001", "  north  office ", "$1,234.50", "1/5/2024 3:15 PM", "a#(cr,lf)b"},
        {"45300", "1002", "SOUTH", "(45)", "2024-02-11T08:00:00", ""},
        {"not a date", "x", null, "12%", "garbage", "   "},
        {null, null, null, null, null, null},
        {" ", "", "", "", "", ""}}),
    Show = (v as any) as text => try (if v = null then "null" else if v is list then "{" & Text.Combine(List.Transform(v, each Text.From(_)), ",") & "}" else Text.From(v)) otherwise "(error)",
    T = (name as text, actual as any, expected as any) => {name, (try (actual = expected) otherwise false), Show(actual), Show(expected)},
    TypeNames = (t as table) => Table.Schema(t)[TypeName],
    // fxApplyTypes
    Typed = fxApplyTypes(Raw, {{"CREATE DATE", type text}, {"MISSING", type date}}),
    TypedSome = fxApplyTypes(Raw, {{"USER ID", type text}}, [DefaultType = null]),
    TypedGB = fxApplyTypes(#table({"D"}, {{"05/01/2024"}}), {{"D", type date}}, [Culture = "en-GB"]),
    TypedInt = fxApplyTypes(#table({"N", "X"}, {{"42", "y"}}), {{"N", Int64.Type}}),
    // fxTrimText
    Trimmed = fxTrimText(Raw),
    Collapsed = fxTrimText(Raw, {"OFFICE"}, [CollapseSpaces = true]),
    // fxSetCase
    Proper = fxSetCase(Trimmed, {"OFFICE", "NOPE"}, "Proper"),
    BadCase = try fxSetCase(Raw, {"OFFICE"}, "Title"){0}[OFFICE],
    // fxToDate
    Dates = fxToDate(Raw, {"CREATE DATE", "WHEN"}, [Culture = "en-US"]),
    DatesGB = fxToDate(#table({"D"}, {{"05/01/2024"}}), {"D"}, [Culture = "en-GB"]),
    DatesFmt = fxToDate(#table({"D"}, {{"20240105"}}), {"D"}, [Format = "yyyyMMdd"]),
    DatesNoOpts = fxToDate(#table({"D"}, {{"2024-03-09"}, {#datetime(2024, 3, 9, 10, 0, 0)}}), {"D"}),
    // fxTextToNumber
    Nums = fxTextToNumber(Raw, {"AMOUNT"}),
    NumsWhole = fxTextToNumber(#table({"N"}, {{"$1,234.50"}, {"2.5"}}), {"N"}, [WholeNumber = true]),
    NumsDE = fxTextToNumber(#table({"N"}, {{"1.234,50"}}), {"N"}, [Culture = "de-DE"]),
    // fxReplaceNulls, fxRemoveBlankRows
    Filled = fxReplaceNulls(Raw, {"OFFICE", "NOPE"}, "Unknown"),
    NoBlank = fxRemoveBlankRows(Raw),
    // fxDedupe
    D = #table({"K", "V"}, {{"a", 1}, {"A", 2}, {"a", 3}, {"b", 4}}),
    Dd = fxDedupe(D, {"K"}),
    DdLast = fxDedupe(D, {"K"}, [KeepLast = true]),
    DdCase = fxDedupe(D, {"K"}, [IgnoreCase = true]),
    DdCaseLast = fxDedupe(D, {"K"}, [IgnoreCase = true, KeepLast = true]),
    // fxAddDateTimeFromPairs
    DT = fxAddDateTimeFromPairs(Raw, {{"WHEN", "When"}}, [Culture = "en-US"]),
    DTDrop = fxAddDateTimeFromPairs(Raw, {{"WHEN", "When"}}, [KeepOriginalColumns = false, Culture = "en-US"]),
    DTTwice = fxAddDateTimeFromPairs(DT, {{"WHEN", "When"}}, [Culture = "en-US"]),
    DTMissing = try Table.RowCount(fxAddDateTimeFromPairs(Raw, {{"NOPE", "X"}})),
    Results = {
        T("ApplyTypes: all text, missing pair skipped", List.Distinct(TypeNames(Typed)), {"Text.Type"}),
        T("ApplyTypes: DefaultType null leaves others", TypeNames(TypedSome){2}, "Any.Type"),
        T("ApplyTypes: USER ID typed text", TypeNames(TypedSome){1}, "Text.Type"),
        T("ApplyTypes: en-GB culture", TypedGB{0}[D], #date(2024, 1, 5)),
        T("ApplyTypes: Int64", TypedInt{0}[N], 42),
        T("TrimText: trims, keeps inner spaces", Trimmed{0}[OFFICE], "north  office"),
        T("TrimText: clean removes line break", Trimmed{0}[NOTES], "ab"),
        T("TrimText: empty to null", Trimmed{1}[NOTES], null),
        T("TrimText: spaces to null", Trimmed{2}[NOTES], null),
        T("TrimText: CollapseSpaces", Collapsed{0}[OFFICE], "north office"),
        T("TrimText: other columns untouched with a list", Collapsed{2}[NOTES], "   "),
        T("SetCase: Proper, missing column skipped", Proper{0}[OFFICE], "North  Office"),
        T("SetCase: null stays null", Proper{2}[OFFICE], null),
        T("SetCase: bad case is an error", BadCase[HasError], true),
        T("ToDate: ISO text", Dates{0}[CREATE DATE], #date(2024, 1, 5)),
        T("ToDate: Excel serial as text", Dates{1}[CREATE DATE], Date.From(45300)),
        T("ToDate: unreadable to null", Dates{2}[CREATE DATE], null),
        T("ToDate: date-time text en-US", Dates{0}[WHEN], #date(2024, 1, 5)),
        T("ToDate: ISO date-time text", Dates{1}[WHEN], #date(2024, 2, 11)),
        T("ToDate: column type", TypeNames(Dates){0}, "Date.Type"),
        T("ToDate: en-GB", DatesGB{0}[D], #date(2024, 1, 5)),
        T("ToDate: Format yyyyMMdd", DatesFmt{0}[D], #date(2024, 1, 5)),
        T("ToDate: no options", DatesNoOpts{0}[D], #date(2024, 3, 9)),
        T("ToDate: datetime value", DatesNoOpts{1}[D], #date(2024, 3, 9)),
        T("TextToNumber: $1,234.50", Nums{0}[AMOUNT], 1234.5),
        T("TextToNumber: (45)", Nums{1}[AMOUNT], -45),
        T("TextToNumber: 12%", Nums{2}[AMOUNT], 0.12),
        T("TextToNumber: empty to null", Nums{4}[AMOUNT], null),
        T("TextToNumber: WholeNumber rounds half up", NumsWhole{0}[N], 1235),
        T("TextToNumber: WholeNumber 2.5", NumsWhole{1}[N], 3),
        T("TextToNumber: de-DE", NumsDE{0}[N], 1234.5),
        T("ReplaceNulls", Filled{2}[OFFICE], "Unknown"),
        T("ReplaceNulls: non-null kept", Filled{1}[OFFICE], "SOUTH"),
        T("RemoveBlankRows: count", Table.RowCount(NoBlank), 3),
        T("Dedupe: first", Dd[V], {1, 2, 4}),
        T("Dedupe: KeepLast", DdLast[V], {2, 3, 4}),
        T("Dedupe: IgnoreCase", DdCase[V], {1, 4}),
        T("Dedupe: IgnoreCase KeepLast", DdCaseLast[V], {3, 4}),
        T("DateTime: date", DT{0}[When date], #date(2024, 1, 5)),
        T("DateTime: time", DT{0}[When time], #time(15, 15, 0)),
        T("DateTime: ISO", DT{1}[When date], #date(2024, 2, 11)),
        T("DateTime: unreadable to null", DT{2}[When date], null),
        T("DateTime: KeepOriginalColumns false", {List.Contains(Table.ColumnNames(DTDrop), "WHEN"), DTDrop{0}[When date]}, {false, #date(2024, 1, 5)}),
        T("DateTime: Overwrite twice", Table.ColumnCount(DTTwice), Table.ColumnCount(DT)),
        T("DateTime: missing column message", try DTMissing[Error][Message] otherwise "", "These columns were not found: NOPE"),
        T("Docs: name in metadata", Value.Metadata(Value.Type(fxTrimText))[Documentation.Name], "fxTrimText")
    },
    Out = #table(type table [Test = text, Pass = logical, Actual = text, Expected = text], Results)
in
    Out
