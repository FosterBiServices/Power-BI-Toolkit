	/// How far Revenue is from its target, as a % of it.
	measure 'Revenue Var %' =
			VAR _Value = [Revenue]
			VAR _Base = [Revenue Budget to Date]
			RETURN
				IF ( NOT ISBLANK ( _Value ) && NOT ISBLANK ( _Base ) && _Base <> 0, DIVIDE ( _Value - _Base, ABS ( _Base ) ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: KPI Visuals\Revenue

	/// Good, Neutral or Bad. Within 2% counts as Neutral; higher is better.
	measure 'Revenue Status' =
			VAR _Var = [Revenue Var %]
			VAR _Score = _Var
			RETURN
				SWITCH (
					TRUE (),
					ISBLANK ( _Var ), BLANK (),
					_Score >= 0.02 && _Score > 0, "Good",
					_Score <= -0.02 && _Score < 0, "Bad",
					"Neutral"
				)
		displayFolder: KPI Visuals\Revenue

	/// Text color for the status (conditional formatting: Field value).
	measure 'Revenue Status Color' =
			SWITCH (
				[Revenue Status],
				"Good", "#006100",
				"Neutral", "#894D00",
				"Bad", "#9C0006"
			)
		displayFolder: KPI Visuals\Revenue

	/// An arrow and the % vs target, for a card reference label or a table column.
	measure 'Revenue Status Label' =
			VAR _Var = [Revenue Var %]
			VAR _Arrow =
				SWITCH ( TRUE (), _Var > 0, UNICHAR ( 9650 ), _Var < 0, UNICHAR ( 9660 ), UNICHAR ( 9658 ) )
			RETURN
				IF ( NOT ISBLANK ( _Var ), _Arrow & " " & FORMAT ( _Var, "+0.0%;-0.0%;0.0%" ) & " vs target" )
		displayFolder: KPI Visuals\Revenue

	/// The last 12 periods of Revenue by 'Date'[Month Start], with the last point in status color. Image size 120 x 32.
	measure 'Revenue Sparkline' =
			VAR _Data =
				TOPN (
					12,
					FILTER ( ADDCOLUMNS ( VALUES ( 'Date'[Month Start] ), "@v", [Revenue] ), NOT ISBLANK ( [@v] ) ),
					'Date'[Month Start], DESC
				)
			VAR _N = COUNTROWS ( _Data )
			VAR _Lo = MINX ( _Data, [@v] )
			VAR _Hi = MAXX ( _Data, [@v] )
			VAR _Range = IF ( _Hi = _Lo, 1, _Hi - _Lo )
			VAR _Pts = ADDCOLUMNS ( _Data, "@x", RANKX ( _Data, 'Date'[Month Start], , ASC ) )
			VAR _Line =
				CONCATENATEX (
					_Pts,
					FORMAT ( 2 + ( [@x] - 1 ) * 116 / MAX ( _N - 1, 1 ), "0.0", "en-US" ) & "," & FORMAT ( 29 - ( [@v] - _Lo ) * 26 / _Range, "0.0", "en-US" ),
					" ",
					[@x], ASC
				)
			VAR _LastV = MAXX ( FILTER ( _Pts, [@x] = _N ), [@v] )
			VAR _LastY = 29 - ( _LastV - _Lo ) * 26 / _Range
			VAR _Color = COALESCE ( [Revenue Status Color], "#01305C" )
			VAR _Svg =
				"<svg xmlns='http://www.w3.org/2000/svg' width='120' height='32' viewBox='0 0 120 32'>"
					& "<polyline points='" & _Line & "' fill='none' stroke='#C5C5C5' stroke-width='1.5' stroke-linejoin='round'/>"
					& "<circle cx='118' cy='" & FORMAT ( _LastY, "0.0", "en-US" ) & "' r='2.5' fill='" & _Color & "'/>"
					& "</svg>"
			RETURN
				IF ( _N >= 2, "data:image/svg+xml;utf8," & SUBSTITUTE ( _Svg, "#", "%23" ) )
		dataCategory: ImageUrl
		displayFolder: KPI Visuals\Revenue

