	measure 'Total Sales YOYTD' =
			VAR ValueCurrentPeriod = [Total Sales YTD]
			VAR ValuePreviousPeriod = [Total Sales PYTD]
			VAR Result =
				IF (
					NOT ISBLANK ( ValueCurrentPeriod ) && NOT ISBLANK ( ValuePreviousPeriod ),
					ValueCurrentPeriod - ValuePreviousPeriod
				)
			RETURN
				Result
		formatString: $#,0
		displayFolder: Time Intelligence

	measure 'Total Sales YOYTD %' =
			VAR ValueCurrentPeriod = [Total Sales YTD]
			VAR ValuePreviousPeriod = [Total Sales PYTD]
			VAR Growth =
				IF (
					NOT ISBLANK ( ValueCurrentPeriod ) && NOT ISBLANK ( ValuePreviousPeriod ),
					ValueCurrentPeriod - ValuePreviousPeriod
				)
			VAR Result = DIVIDE ( Growth, ValuePreviousPeriod )
			RETURN
				Result
		formatString: 0.0%
		displayFolder: Time Intelligence

