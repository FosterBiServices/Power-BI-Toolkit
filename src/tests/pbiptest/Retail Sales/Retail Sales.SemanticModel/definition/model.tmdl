model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Customer","Sales","Date"]

ref table Customer
ref table Sales
ref table Date
ref table _Measures
ref table 'Sales Metric'
