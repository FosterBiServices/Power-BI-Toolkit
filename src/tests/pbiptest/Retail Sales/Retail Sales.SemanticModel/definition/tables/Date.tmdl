table Date
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		summarizeBy: none
		sourceColumn: [Date]

	column Year = YEAR('Date'[Date])
		dataType: int64
		summarizeBy: none

	column Month = FORMAT('Date'[Date], "mmm")
		dataType: string
		summarizeBy: none
		sortByColumn: 'Month Number'

	column 'Month Number' = MONTH('Date'[Date])
		dataType: int64
		isHidden
		summarizeBy: none

	hierarchy Calendar

		level Year
			column: Year

		level Month
			column: Month

	partition Date = calculated
		mode: import
		source = CALENDAR(DATE(2023, 1, 1), DATE(2025, 12, 31))
