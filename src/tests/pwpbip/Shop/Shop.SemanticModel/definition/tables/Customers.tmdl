table Customers
	lineageTag: c0

	column 'Customer Key'
		dataType: int64
		formatString: 0
		lineageTag: c1
		summarizeBy: none
		sourceColumn: Customer Key

	column 'Customer Name'
		dataType: string
		lineageTag: c2
		summarizeBy: none
		sourceColumn: Customer Name

	column Region
		dataType: string
		lineageTag: c3
		summarizeBy: none
		sourceColumn: Region

	partition Customers = m
		mode: import
		source =
				let
				    Source = Sql.Database("sql-prod", "SalesDW"),
				    Customers = Source{[Schema = "dbo", Item = "Customers"]}[Data]
				in
				    Customers
